---
import Base from '../layouts/Base.astro';
import Generique from '../components/Generique.astro';
import KeyBoard from '../components/KeyBoard.astro';
import PhotoSlot from '../components/PhotoSlot.astro';
import Status from '../components/Status.astro';
import MapFacade from '../components/MapFacade.astro';
import site from '../data/site.json';
import avis from '../data/avis.json';
---
<Base
  title="Le Bel Air : hôtel, restaurant et bar à Saint-Brice-sous-Forêt"
  description="Hôtel, restaurant méditerranéen et bar à cocktails avec terrasse à Saint-Brice-sous-Forêt. Nouvelle équipe, décor refait. Tél. 09 50 51 08 86."
>
  <Generique slot="intro" />

  <!-- Carton-titre -->
  <section class="carton" aria-labelledby="titre-principal">
    <div class="enveloppe carton-in">
      <div class="carton-titre">
        <p class="carton-sur">Saint-Brice-sous-Forêt, avenue du Général de Gaulle</p>
        <h1 id="titre-principal">
          <span class="nom">Le Bel Air</span>
          <span class="sous">Hôtel, restaurant et bar à cocktails à <span class="nowrap">Saint-Brice-sous-Forêt</span></span>
        </h1>
        <p class="carton-chapo">Nouvelle équipe, décor refait à neuf, grande terrasse. Et une chambre du deuxième étage où Belmondo et Anconina ont tourné une scène en 1988.</p>
        <div class="carton-actions">
          <a class="btn btn-cerise" href="/chambres/#disponibilite">Demander une disponibilité</a>
          <a class="btn btn-laiton" href={`tel:${site.telephoneIntl}`}>Appeler le {site.telephone}</a>
        </div>
      </div>

      <dl class="credits defile" aria-label="L'hôtel en bref">
        <dt>Adresse</dt><dd>67 avenue du Général de Gaulle</dd>
        <dt>Route</dt><dd>l'ancienne Nationale 1</dd>
        <dt>Cuisine</dt><dd>méditerranéenne, crêpes</dd>
        <dt>Au bar</dt><dd>cocktails</dd>
        <dt>Dehors</dt><dd>une grande terrasse</dd>
        <dt>Voiture</dt><dd>parking facile</dd>
        <dt>Cinéma</dt><dd>Itinéraire d'un enfant gâté, 1988</dd>
        <dt>Téléphone</dt><dd><a href={`tel:${site.telephoneIntl}`}>{site.telephone}</a></dd>
      </dl>
    </div>
  </section>

  <KeyBoard />

  <!-- Une scène de cinéma -->
  <section class="cinema" aria-labelledby="cinema-titre">
    <div class="enveloppe cinema-in">
      <div>
        <p class="tampon" aria-hidden="true">Tourné ici<br /><span>1988</span></p>
        <h2 id="cinema-titre">Une scène de cinéma, au deuxième étage</h2>
        <p>En 1988, Claude Lelouch tourne une partie d'<cite>Itinéraire d'un enfant gâté</cite> au Bel Air. Jean-Paul Belmondo et Richard Anconina s'y retrouvent en tête-à-tête, dans une chambre du deuxième étage, pour une scène que beaucoup connaissent encore par cœur.</p>
        <p><a class="lien-laiton" href="/une-scene-de-cinema/">L'histoire du tournage, racontée par l'hôtel</a></p>
      </div>
      <dl class="credits">
        <dt>Film</dt><dd><cite>Itinéraire d'un enfant gâté</cite></dd>
        <dt>Réalisation</dt><dd>Claude Lelouch</dd>
        <dt>Avec</dt><dd>Jean-Paul Belmondo, Richard Anconina</dd>
        <dt>Année</dt><dd>1988</dd>
        <dt>Décor</dt><dd>Hôtel Le Bel Air, Saint-Brice-sous-Forêt</dd>
      </dl>
    </div>
  </section>

  <!-- Le renouveau -->
  <section class="renouveau sur-creme" aria-labelledby="renouveau-titre">
    <div class="enveloppe renouveau-in">
      <PhotoSlot class="renouveau-photo" titre="la salle refaite" legende="Vue large du restaurant, lumière du soir, tables dressées." ratio="4 / 5" />
      <div class="renouveau-txt">
        <h2 id="renouveau-titre">Nouvelle équipe, décor refait</h2>
        <p>Le Bel Air a changé de mains. La nouvelle équipe a refait le décor de fond en comble : une ambiance plus douce, plus cocooning, de la salle du restaurant jusqu'au bar.</p>
        <p>Ce qui ne change pas : l'adresse au bord de l'ancienne Nationale 1, le parking facile et la terrasse, qui reste l'endroit où l'on s'attarde.</p>
        <p class="signature">La direction <span class="a-confirmer">[À CONFIRMER : nom du propriétaire]</span></p>
      </div>
    </div>
  </section>

  <!-- Avis -->
  <section class="critiques" aria-labelledby="critiques-titre">
    <div class="enveloppe">
      <div class="critiques-tete">
        <h2 id="critiques-titre">Ce qu'en disent les clients</h2>
        <p>Note de {site.note.valeur} sur 5, sur environ {site.note.avis} avis Google.</p>
      </div>
      <ul class="critiques-liste">
        {avis.map((a, i) => (
          <li class={`critique c${i + 1}`}>
            <blockquote><p>« {a.texte} »</p></blockquote>
            <p class="source">Avis Google</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Événements -->
  <section class="evenements sur-creme" aria-labelledby="evt-titre">
    <div class="enveloppe evt-in">
      <h2 id="evt-titre">Fêter quelque chose ici</h2>
      <ul class="evt-liste">
        <li><span class="evt-nom">Un anniversaire</span><span>une table, la terrasse ou le bar selon le nombre</span></li>
        <li><span class="evt-nom">Une soirée à deux</span><span>dîner, cocktail, et une chambre à l'étage</span></li>
        <li><span class="evt-nom">Un groupe</span><span>dites-nous combien vous êtes, on s'organise</span></li>
      </ul>
      <a class="btn btn-laiton" href="/evenements/">Préparer un événement</a>
    </div>
  </section>

  <!-- Infos pratiques -->
  <section class="infos" aria-labelledby="infos-titre">
    <div class="enveloppe infos-in">
      <div class="infos-txt">
        <h2 id="infos-titre">Venir au Bel Air</h2>
        <address>{site.adresse.rue}<br />{site.adresse.codePostal} {site.adresse.ville}</address>
        <Status class="infos-statut" />
        <p>Au bord de l'ancienne Nationale 1. Parking facile sur place.</p>
        <div class="carton-actions">
          <a class="btn btn-cerise" href={`tel:${site.telephoneIntl}`}>{site.telephone}</a>
          <a class="btn btn-laiton" href="/infos-pratiques/">Horaires et accès</a>
        </div>
      </div>
      <MapFacade />
    </div>
  </section>
</Base>

<style>
  /* Carton-titre */
  .carton { padding-block: 3.5rem 4.5rem; position: relative; }
  .carton-in { display: grid; gap: 3rem; }
  .carton-sur { color: var(--color-laiton-clair); margin: 0 0 1.25rem; font-size: .95rem; }
  h1 { margin: 0; display: grid; gap: 1.1rem; }
  .nom { font-style: italic; font-size: clamp(4.2rem, 17vw, 11.5rem); line-height: .88; letter-spacing: -.025em; font-weight: 500; margin-left: -.04em; }
  .sous { font-size: clamp(1.35rem, 3.2vw, 2rem); font-weight: 400; line-height: 1.2; max-width: 24ch; }
  .carton-chapo { max-width: 46ch; color: var(--color-brume); margin: 1.5rem 0 2rem; font-size: 1.1rem; }
  .carton-actions { display: flex; flex-wrap: wrap; gap: .75rem; }
  .defile { align-self: end; font-size: .98rem; border-top: 1px solid rgba(176,141,87,.4); padding-top: 1.5rem; }
  .defile dd a { color: var(--color-creme); }
  @media (min-width: 64rem) {
    .carton { padding-block: 5rem 6rem; }
    .carton-in { grid-template-columns: 1fr 19rem; gap: 4rem; }
    .defile { border-top: 0; border-left: 1px solid rgba(176,141,87,.4); padding: 0 0 0 2rem; grid-template-columns: 7rem 1fr; }
    .defile dt { text-align: left; }
  }
  /* Les crédits montent un à un, une seule fois, après le générique */
  :global(html.credits-run) .defile > * { animation: credit-up .7s ease both; }
  :global(html.credits-run) .defile > :nth-child(1), :global(html.credits-run) .defile > :nth-child(2) { animation-delay: .1s; }
  :global(html.credits-run) .defile > :nth-child(3), :global(html.credits-run) .defile > :nth-child(4) { animation-delay: .3s; }
  :global(html.credits-run) .defile > :nth-child(5), :global(html.credits-run) .defile > :nth-child(6) { animation-delay: .5s; }
  :global(html.credits-run) .defile > :nth-child(7), :global(html.credits-run) .defile > :nth-child(8) { animation-delay: .7s; }
  :global(html.credits-run) .defile > :nth-child(9), :global(html.credits-run) .defile > :nth-child(10) { animation-delay: .9s; }
  :global(html.credits-run) .defile > :nth-child(11), :global(html.credits-run) .defile > :nth-child(12) { animation-delay: 1.1s; }
  :global(html.credits-run) .defile > :nth-child(13), :global(html.credits-run) .defile > :nth-child(14) { animation-delay: 1.3s; }
  :global(html.credits-run) .defile > :nth-child(15), :global(html.credits-run) .defile > :nth-child(16) { animation-delay: 1.5s; }
  @keyframes credit-up { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }

  /* Cinéma */
  .cinema { padding-block: 5rem; background: #0a1220; }
  .cinema-in { display: grid; gap: 3rem; align-items: center; }
  .cinema h2 { font-size: clamp(2.2rem, 5vw, 3.6rem); margin: 0 0 1.25rem; max-width: 16ch; }
  .cinema p { max-width: 52ch; }
  .tampon {
    display: inline-block; margin: 0 0 1.75rem; padding: .5rem .9rem .45rem;
    border: 2px solid #c4384a; color: #e7a0a8; transform: rotate(-4deg);
    font-family: var(--font-titre); font-style: italic; font-size: 1rem; line-height: 1.1; text-align: center;
  }
  .tampon span { font-style: normal; font-size: 1.6rem; font-weight: 600; letter-spacing: .06em; }
  .cinema .credits { font-size: 1.05rem; }
  @media (min-width: 56rem) { .cinema-in { grid-template-columns: 1.1fr .9fr; gap: 5rem; } }

  /* Renouveau */
  .renouveau { padding-block: 5rem; }
  .renouveau-in { display: grid; gap: 2.5rem; }
  .renouveau-txt h2 { font-size: clamp(2.2rem, 5vw, 3.6rem); margin: 0 0 1.5rem; }
  .renouveau-txt p { max-width: 50ch; font-size: 1.08rem; }
  .signature { font-family: var(--font-titre); font-style: italic; color: var(--color-laiton-fonce); }
  @media (min-width: 56rem) {
    .renouveau-in { grid-template-columns: 5fr 7fr; gap: 5rem; align-items: center; }
    .renouveau-photo { margin-top: -8rem; }
  }

  /* Critiques */
  .critiques { padding-block: 5rem; }
  .critiques-tete { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 1rem 2rem; border-bottom: 1px solid rgba(176,141,87,.4); padding-bottom: 1.25rem; margin-bottom: 3rem; }
  .critiques-tete h2 { font-size: clamp(2rem, 4.5vw, 3.2rem); margin: 0; }
  .critiques-tete p { margin: 0; color: var(--color-laiton-clair); }
  .critiques-liste { list-style: none; margin: 0; padding: 0; display: grid; gap: 2.75rem; }
  .critique blockquote { margin: 0; }
  .critique blockquote p { margin: 0; font-family: var(--font-titre); font-style: italic; line-height: 1.25; font-size: clamp(1.3rem, 2.6vw, 1.75rem); }
  .critique .source { margin: .6rem 0 0; font-size: .9rem; color: var(--color-laiton-clair); }
  .c1 blockquote p { font-size: clamp(1.6rem, 3.6vw, 2.6rem); }
  @media (min-width: 56rem) {
    .critiques-liste { grid-template-columns: repeat(6, 1fr); gap: 3.5rem 3rem; }
    .c1 { grid-column: 1 / 5; }
    .c2 { grid-column: 5 / 7; padding-top: 1rem; }
    .c3 { grid-column: 1 / 3; }
    .c4 { grid-column: 3 / 5; }
    .c5 { grid-column: 5 / 7; }
    .c5 blockquote p { color: var(--color-laiton-clair); }
  }

  /* Événements */
  .evenements { padding-block: 5rem; border-top: 1px solid var(--color-creme-2); }
  .evt-in h2 { font-size: clamp(2.2rem, 5vw, 3.6rem); margin: 0 0 2rem; }
  .evt-liste { list-style: none; margin: 0 0 2.25rem; padding: 0; display: grid; }
  .evt-liste li { display: grid; gap: .2rem; padding: 1.1rem 0; border-bottom: 1px solid rgba(122,92,46,.35); }
  .evt-nom { font-family: var(--font-titre); font-size: clamp(1.5rem, 3.4vw, 2.2rem); line-height: 1.1; }
  @media (min-width: 48rem) { .evt-liste li { grid-template-columns: 20rem 1fr; align-items: baseline; } }

  /* Infos */
  .infos { padding-block: 5rem; }
  .infos-in { display: grid; gap: 2.5rem; }
  .infos h2 { font-size: clamp(2.2rem, 5vw, 3.6rem); margin: 0 0 1.25rem; }
  .infos address { font-style: normal; font-family: var(--font-titre); font-size: 1.35rem; line-height: 1.35; margin-bottom: 1rem; }
  .infos-txt > p { max-width: 42ch; }
  :global(.infos-statut) { margin-bottom: .5rem !important; }
  @media (min-width: 56rem) { .infos-in { grid-template-columns: 1fr 1fr; gap: 4rem; align-items: center; } }
</style>
