---
// Clé de chambre à pampille en laiton, dessinée en SVG (décorative).
interface Props { numero: string | number; class?: string; }
const { numero, class: cls = '' } = Astro.props;
const id = `laiton-${numero}`;
---
<svg class={`cle ${cls}`} viewBox="0 0 140 330" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id={id} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#d9bd86" />
      <stop offset=".55" stop-color="#b08d57" />
      <stop offset="1" stop-color="#7f6034" />
    </linearGradient>
  </defs>
  <!-- anneau -->
  <circle cx="70" cy="22" r="15" fill="none" stroke={`url(#${id})`} stroke-width="5" />
  <!-- clé -->
  <g fill={`url(#${id})`}>
    <rect x="51" y="30" width="7" height="58" rx="2" transform="rotate(-18 54 30)" />
    <rect x="37" y="74" width="12" height="5" transform="rotate(-18 54 30)" />
    <rect x="37" y="82" width="9" height="5" transform="rotate(-18 54 30)" />
  </g>
  <!-- maillon -->
  <rect x="66" y="35" width="8" height="26" rx="4" fill="none" stroke={`url(#${id})`} stroke-width="3.5" />
  <!-- pampille -->
  <path d="M70 58c27 0 46 17 46 44v128c0 38-22 66-46 92-24-26-46-54-46-92V102c0-27 19-44 46-44Z" fill={`url(#${id})`} />
  <path d="M70 68c21 0 36 13 36 35v126c0 32-17 56-36 78-19-22-36-46-36-78V103c0-22 15-35 36-35Z" fill="none" stroke="#6b4f27" stroke-width="1.5" opacity=".7" />
  <circle cx="70" cy="84" r="7" fill="#0f1a2a" stroke="#6b4f27" stroke-width="1.5" />
  <text x="70" y="196" text-anchor="middle" font-family="Bodoni Moda Variable, Didot, Georgia, serif" font-size="84" font-weight="600" fill="#3d2c12" opacity=".88">{numero}</text>
  <text x="70" y="248" text-anchor="middle" font-family="Bodoni Moda Variable, Didot, Georgia, serif" font-style="italic" font-size="15" fill="#3d2c12" opacity=".8">Le Bel Air</text>
  <text x="70" y="266" text-anchor="middle" font-family="Jost Variable, sans-serif" font-size="8.5" letter-spacing="1.2" fill="#3d2c12" opacity=".7">SAINT-BRICE</text>
</svg>
