---
import site from '../data/site.json';
---
<div class="carte" data-carte data-src={site.carteEmbed}>
  <svg viewBox="0 0 400 200" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false" class="carte-plan">
    <rect width="400" height="200" fill="#22344f" />
    <path d="M90 -10 L 160 210" stroke="#b9c0ca" stroke-width="2" opacity=".3" />
    <path d="M320 -10 C 300 70 315 140 285 210" stroke="#b9c0ca" stroke-width="2" opacity=".3" />
    <path d="M-10 170 C 90 150 160 125 230 92 S 360 30 420 14" stroke="#b08d57" stroke-width="7" fill="none" opacity=".8" />
    <path d="M-10 170 C 90 150 160 125 230 92 S 360 30 420 14" stroke="#0f1a2a" stroke-width="1.5" stroke-dasharray="8 8" fill="none" />
    <text x="24" y="146" font-family="Jost Variable, sans-serif" font-size="12" fill="#d2b27a" transform="rotate(-11 24 146)">ancienne Nationale 1</text>
    <circle cx="230" cy="92" r="10" fill="#a51e2f" stroke="#f1e9da" stroke-width="3" />
    <text x="246" y="122" font-family="Jost Variable, sans-serif" font-size="14" fill="#f1e9da">Le Bel Air</text>
  </svg>
  <div class="carte-bas">
    <p class="carte-adresse">{site.adresse.rue}<br />{site.adresse.codePostal} {site.adresse.ville}</p>
    <button type="button" class="btn btn-laiton carte-btn" data-carte-btn>Afficher la carte Google Maps</button>
    <p class="carte-note">La carte est chargée depuis Google seulement après votre clic.</p>
  </div>
</div>

<style>
  .carte { position: relative; display: flex; flex-direction: column; background: var(--color-nuit); border: 1px solid rgba(176,141,87,.4); overflow: hidden; min-height: 24rem; }
  .carte-plan { display: block; width: 100%; height: 11rem; flex: 1 1 auto; }
  .carte-bas { display: grid; gap: .75rem; padding: 1.25rem; border-top: 1px solid rgba(176,141,87,.4); }
  .carte-adresse, .carte-note { margin: 0; }
  .carte-adresse { font-family: var(--font-titre); font-size: 1.15rem; line-height: 1.3; }
  .carte-btn { justify-self: start; }
  .carte-note { font-size: .85rem; color: var(--color-brume); }
  .carte :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-carte]').forEach((box) => {
    box.querySelector('[data-carte-btn]')?.addEventListener('click', () => {
      const f = document.createElement('iframe');
      f.src = box.dataset.src || '';
      f.title = 'Carte Google Maps : Hôtel Le Bel Air, Saint-Brice-sous-Forêt';
      f.referrerPolicy = 'no-referrer-when-downgrade';
      box.replaceChildren(f);
      f.focus();
    });
  });
</script>
